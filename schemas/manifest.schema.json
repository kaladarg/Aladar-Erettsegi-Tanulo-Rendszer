{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://kaladarg.github.io/Aladar-Erettsegi-Tanulo-Rendszer/schemas/manifest.schema.json",
  "title": "Manifest",
  "description": "Entry point of a content pack: the subjects, levels and exams it contains.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packId", "title", "updatedAt", "subjects", "levels", "exams"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "packId": {
      "$ref": "#/definitions/Slug"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "notice": {
      "description": "Ownership/licensing notice shown in the app.",
      "type": "string"
    },
    "repositoryUrl": {
      "description": "Repository of the content pack (shown as its source).",
      "type": "string",
      "pattern": "^https?://"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Subject"
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/Level"
      }
    },
    "exams": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/ExamEntry"
      }
    },
    "reportEmail": {
      "description": "Where students report data mistakes (defaults to the app maintainer).",
      "type": "string",
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    }
  },
  "definitions": {
    "Slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "Subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "icon"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "icon": {
          "enum": ["sigma", "landmark", "book-open", "book", "languages"]
        }
      }
    },
    "Level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "$ref": "#/definitions/Slug"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "ExamEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "subject",
        "level",
        "year",
        "session",
        "format",
        "title",
        "maxPoints",
        "path",
        "sha256",
        "hasPdf",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/definitions/Slug"
        },
        "subject": {
          "$ref": "#/definitions/Slug"
        },
        "level": {
          "$ref": "#/definitions/Slug"
        },
        "year": {
          "type": "integer"
        },
        "session": {
          "enum": ["majus", "oktober"]
        },
        "format": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "sample": {
          "type": "boolean"
        },
        "maxPoints": {
          "type": "integer",
          "minimum": 1
        },
        "path": {
          "description": "Path of exam.json relative to the manifest.",
          "type": "string"
        },
        "sha256": {
          "description": "Hash of exam.json, used for cache busting.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "hasPdf": {
          "description": "Whether the pack ships the exam PDF.",
          "type": "boolean"
        },
        "pdfSha256": {
          "description": "SHA-256 of the official exam PDF, so a PDF the student opens can be matched to this exam.",
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "status": {
          "enum": ["draft", "reviewed"]
        }
      }
    }
  }
}
