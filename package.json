{
  "name": "erettsegi-gyakorlo",
  "private": true,
  "version": "0.1.0",
  "description": "Free, open-source, ad-free web app for practicing Hungarian érettségi exams.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "schemas": "tsx tools/schemas.ts",
    "content:init": "tsx tools/content-init.ts",
    "content:crawl": "tsx tools/crawl.ts",
    "content:extract": "tsx tools/extract.ts",
    "content:review": "tsx tools/review.ts",
    "content:pack": "tsx tools/build-pack.ts",
    "demo:build": "tsx tools/demo/build-demo-pack.ts",
    "dev:content": "vite --mode content",
    "preview:content": "vite preview --mode content",
    "lighthouse": "lhci autorun --config=lighthouserc.cjs",
    "build:portable": "BASE_PATH=./ VITE_PORTABLE=1 vite build --outDir dist-portable",
    "content:check-key": "tsx --tsconfig tsconfig.node.json tools/check-key.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.59.0",
    "pdfjs-dist": "^6.4.299",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "ajv": "^8.20.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-window": "^7.4.1"
  }
}
